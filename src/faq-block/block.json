{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cis/accessible-accordion-faq",
	"version": "3.0.1",
	"title": "Accessible FAQ Accordion",
	"category": "text",
	"icon": "editor-help",
	"description": "Accessible FAQ accordion with optional FAQPage JSON-LD schema. Theme-inheriting, no dependencies.",
	"keywords": [ "faq", "accordion", "schema", "questions", "answers" ],
	"textdomain": "accessible-accordion-faq-schema",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"titleLevel": {
			"type": "number",
			"default": 2
		},
		"collapsible": {
			"type": "boolean",
			"default": false
		},
		"enableSchema": {
			"type": "boolean",
			"default": false
		},
		"blockVersion": {
			"type": "number",
			"default": 0
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"cis/accessible-accordion-faq/collapsible": "collapsible"
	},
	"example": {
		"attributes": {
			"title": "Frequently Asked Questions",
			"titleLevel": 2,
			"collapsible": false
		},
		"innerBlocks": [
			{
				"name": "cis/faq-item",
				"attributes": { "question": "What is your return policy?" },
				"innerBlocks": [
					{ "name": "core/paragraph", "attributes": { "content": "You can return items within 30 days of purchase." } }
				]
			},
			{
				"name": "cis/faq-item",
				"attributes": { "question": "Do you ship internationally?" },
				"innerBlocks": [
					{ "name": "core/paragraph", "attributes": { "content": "Yes, we ship to most countries worldwide." } }
				]
			}
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
